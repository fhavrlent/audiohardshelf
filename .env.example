# Audiobookshelf configuration
ABS_URL=http://your-audiobookshelf-server:port
ABS_API_KEY=your_audiobookshelf_api_key

# Hardcover.app configuration
HARDCOVER_API_KEY=your_hardcover_api_key
# Note: You can include "Bearer " prefix in your API key or leave it out - the app will handle either format
# HARDCOVER_API_URL=https://api.hardcover.app/v1/graphql  # Optional override of the GraphQL endpoint

# Sync configuration
# Progress syncs within minutes of listening. This interval is a fallback
# for anything missed, e.g. while Audiobookshelf was unreachable (default: 1h)
SYNC_INTERVAL=1h

# API Configuration (Optional)
# Timeout for API requests in milliseconds (default: 10000 = 10 seconds)
# API_TIMEOUT_MS=10000

# Logging Configuration (Optional)
# Log level: error, warn, info, debug (default: debug). Logs go to stdout.
# LOG_LEVEL=debug
